+"""Disable Assistant and check legacy transit presets through the real corner menu.
+
+Requires the installed, reloaded module and an unlocked phone. Restores settings
+and Assistant's enabled state; never takes screenshots of payment/transit pages.
+"""
+
+import json
+import os
+import re
+import shlex
+import subprocess
+import tempfile
+import time
+from pathlib import Path
+
+from activity_shortcuts_test import arc_point
+from corner_touch_test import wait_menu
+from main_ui_test import adb, preferences, snapshot
+from preset_shortcuts_test import KEY, PACKAGE, PRESETS, write_shortcuts
+
+
+ASSISTANT = "com.coloros.assistantscreen"
+CHECKS = PACKAGE + ".transitchecks"
+# Keep the tested icons away from the near-vertical end of the arc so a single
+# injected straight swipe satisfies the corner's inward-diagonal recognition.
+ORDER = (4, 5, 0, 1, 2, 3)
+
+
+def run(*args):
+    return subprocess.check_output(["rtk", "proxy", *map(str, args)], text=True,
+                                   stderr=subprocess.STDOUT, timeout=180)
+
+
+def root(command):
+    return adb("shell", "su", "-c", shlex.quote(command))
+
+
+def preset_checks():
+    sdk = Path(os.environ.get("ANDROID_HOME", str(Path.home() / "Library/Android/sdk")))
+    tools, android = sdk / "build-tools/36.0.0", sdk / "platforms/android-35/android.jar"
+    with tempfile.TemporaryDirectory() as directory:
+        folder = Path(directory)
+        manifest = folder / "AndroidManifest.xml"
+        manifest.write_text('<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="' + CHECKS + '">'
+                            '<application android:label="MBack transit checks"/>'
+                            '<instrumentation android:name="dev.mback.oneplus.TransitShortcutsInstrumentation" '
+                            'android:targetPackage="dev.mback.oneplus"/></manifest>')
+        classes, dex, apk = folder / "classes", folder / "dex", folder / "checks.apk"
+        classes.mkdir()
+        dex.mkdir()
+        run("javac", "-source", "8", "-target", "8", "-cp", str(android) + ":app/build/local/classes",
+            "-d", classes, "tests/android/TransitShortcutsInstrumentation.java")
+        run(tools / "d8", "--min-api", "29", "--lib", android, "--output", dex, *classes.rglob("*.class"))
+        run(tools / "aapt2", "link", "-o", apk, "--manifest", manifest, "-I", android,
+            "--min-sdk-version", "29", "--target-sdk-version", "35")
+        run("zip", "-q", "-j", apk, dex / "classes.dex")
+        run(tools / "apksigner", "sign", "--ks", Path.home() / ".android/debug.keystore",
+            "--ks-key-alias", "androiddebugkey", "--ks-pass", "pass:android", "--key-pass", "pass:android", apk)
+        run("adb", "push", apk, "/data/local/tmp/mback-transit-checks.apk")
+        root("pm install -r /data/local/tmp/mback-transit-checks.apk")
+        result = adb("shell", "am", "instrument", "-w", "-r", CHECKS + "/dev.mback.oneplus.TransitShortcutsInstrumentation")
+        assert "Transit preset checks passed" in result and "INSTRUMENTATION_CODE: -1" in result, result
+        print("Legacy IDs, enabled state, distinct payment/transit routes and argument rejection passed", flush=True)
+    print("Direct launch requires the system permission and SystemUI token; arbitrary parameters are rejected", flush=True)
+
+
+def launch(index, original, cold):
+    name = PRESETS[index][0]
+    package = "com.tencent.mm" if index == 4 else "com.eg.android.AlipayGphone"
+    expected = (package + "/.plugin.appbrand.ui.AppBrandUI" if index == 4 else
+                package + "/com.alipay.android.phone.xriver.bundlex.CSGAPushActivity")
+    if cold:
+        adb("shell", "am", "force-stop", package)
+    adb("shell", "input", "keyevent", "KEYCODE_HOME")
+    adb("shell", "am", "start", "-W", "--windowingMode", "1", "-a", "android.settings.SETTINGS")
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline:
+        windows = adb("shell", "dumpsys", "window", "displays")
+        if re.search(r"mCurrentFocus=Window\{[^\n]*com.android.settings/", windows):
+            break
+        time.sleep(.1)
+    else:
+        raise AssertionError("Settings did not receive focus after the native window transition")
+    width, height = map(int, re.findall(r"(\d+)x(\d+)", adb("shell", "wm", "size"))[-1])
+    density = int(re.findall(r"\d+", adb("shell", "wm", "density"))[-1]) / 160
+    x, y = arc_point(ORDER.index(index) + 1, original, width, height, density, len(PRESETS) + 1)
+    start_x, start_y = round(16 * density), height - round(32 * density)
+    time.sleep(1)
+    gesture = subprocess.Popen(["rtk", "proxy", "adb", "shell", "input", "swipe", str(start_x), str(start_y),
+                                str(x), str(y), "1600"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    try:
+        wait_menu(True)
+    finally:
+        _, error = gesture.communicate(timeout=10)
+    assert gesture.returncode == 0, error
+    wait_menu(False)
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline:
+        activities = adb("shell", "dumpsys", "activity", "activities")
+        top = "\n".join(line for line in activities.splitlines() if "topResumedActivity=" in line)
+        if expected in top:
+            tree = snapshot()
+            keyword = "乘车码" if index == 4 else "出行"
+            if any(keyword in n.get("text", "") + n.get("content-desc", "") for n in tree.iter("node")):
+                print(name + (" cold" if cold else " warm") + ": transit page reached without Assistant", flush=True)
+                return
+        time.sleep(.2)
+    raise AssertionError(name + " did not reach its transit page")
+
+
+def main():
+    policy = adb("shell", "dumpsys", "window", "policy")
+    assert re.search(r"^\s+showing=false$", policy, re.M), "Unlock the phone before testing"
+    original = preferences()
+    state = re.search(r"User 0: [^\n]* enabled=(\d+)", adb("shell", "dumpsys", "package", ASSISTANT))[1]
+    assert original.get("mback_corner_menu_enabled", "1") == "1", "Enable corner shortcuts first"
+    stamp = adb("shell", "date", "+%m-%d_%H:%M:%S.000").strip().replace("_", " ")
+    try:
+        root("pm disable-user --user 0 " + ASSISTANT)
+        preset_checks()
+        write_shortcuts(json.dumps([{"id": PRESETS[index][1]} for index in ORDER]))
+        for cold in (True, False):
+            for index in (4, 5):
+                launch(index, original, cold)
+        events = adb("shell", "logcat", "-b", "events", "-d", "-v", "time", "-T", shlex.quote(stamp))
+        assert not any(ASSISTANT in line and ("wm_create_activity" in line or "wm_new_intent" in line)
+                       for line in events.splitlines()), "Assistant participated in a launch"
+    finally:
+        adb("shell", "input", "motionevent", "CANCEL", "0", "0")
+        adb("shell", "input", "keyevent", "KEYCODE_HOME")
+        adb("shell", "am", "force-stop", PACKAGE)
+        if KEY in original:
+            write_shortcuts(original[KEY])
+        else:
+            root("settings delete global " + KEY)
+        command = {"0": "default-state", "1": "enable", "2": "disable", "3": "disable-user", "4": "disable-until-used"}[state]
+        root("pm " + command + " --user 0 " + ASSISTANT)
+        root("pm uninstall " + CHECKS)
+        adb("shell", "rm", "-f", "/data/local/tmp/mback-transit-checks.apk", "/data/local/tmp/mback-main-test.xml")
+        assert preferences() == original, "Original settings were not restored"
+    print("Assistant was never launched; original settings and enabled state restored", flush=True)
+
+
+if __name__ == "__main__":
+    main()
