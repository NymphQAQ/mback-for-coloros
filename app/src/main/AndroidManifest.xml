<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.mback.oneplus">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application android:allowBackup="false" android:label="MBack · Xposed" android:theme="@style/MBackTheme">
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposedminversion" android:value="82"/>
        <meta-data android:name="xposeddescription" android:value="ColorOS mBack 与 Flyme 风格边角小窗菜单"/>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name=".TestActivity" android:exported="false"/>
        <activity android:name=".BackupActivity" android:exported="false" android:label="备份与恢复"/>
        <activity android:name=".IconLibraryActivity" android:exported="false" android:label="图标库"/>
        <activity android:name=".WindowPreviewActivity" android:exported="true"
                  android:label="小窗位置预览" android:resizeableActivity="true"
                  android:taskAffinity="dev.mback.oneplus.windowpreview" android:launchMode="singleTask"/>
        <activity android:name=".WechatTransitActivity" android:exported="true"
                  android:permission="android.permission.STATUS_BAR"
                  android:theme="@android:style/Theme.NoDisplay"
                  android:excludeFromRecents="true" android:noHistory="true"
                  android:taskAffinity="dev.mback.oneplus.transit"/>
        <!-- SystemUI opens this parameter-free activity in a separate native small-window task. -->
        <activity android:name=".MoreAppsActivity" android:exported="true"
                  android:label="更多应用" android:resizeableActivity="true"
                  android:taskAffinity="dev.mback.oneplus.shortcuts" android:launchMode="singleTask"/>
        <provider android:name=".ShortcutProvider" android:authorities="dev.mback.oneplus.shortcuts"
                  android:exported="true"/>
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/></intent-filter>
        </receiver>
    </application>
</manifest>
